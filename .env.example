# Copy to .env.development.local (npm run dev) or pass as build args (Docker).

# API base URL, no trailing slash. Local dev API: http://localhost:8002
VITE_BASE_URL=http://192.168.15.61:8001/api

# Stringee Web SDK script. Pin a specific SDK version for production.
VITE_STRINGEE_SDK_URL=https://cdn.stringee.com/sdk/web/latest/stringee-web-sdk.min.js

# Mask customer phone numbers and emails for users without PII access ("true" / "false").
VITE_MASK_PII_ENABLED=
